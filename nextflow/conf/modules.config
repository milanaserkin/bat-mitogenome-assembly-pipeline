// Per-process arguments and publishing rules.

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':').last().toLowerCase()}" },
        mode: params.publish_dir_mode
    ]

    withName: 'PORECHOP_PORECHOP' {
        ext.args   = params.porechop_args
        publishDir = [ path: { "${params.outdir}/porechop/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    withName: 'FASTPLONG' {
        ext.args   = params.fastplong_args
        publishDir = [ path: { "${params.outdir}/fastplong/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // All minimap2 invocations (extraction + polishing rounds) use ONT mapping.
    withName: '.*MINIMAP2.*' {
        ext.args = params.minimap2_args
    }

    withName: '.*MINIMAP2_EXTRACT' {
        publishDir = [ path: { "${params.outdir}/minimap2/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    withName: 'SEQTK_SUBSEQ' {
        ext.prefix = { "${meta.id}_mitoreads" }
        publishDir = [ path: { "${params.outdir}/mito_reads/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // Flye min-overlap sweep: one task per overlap value, disambiguated by prefix.
    withName: 'FLYE' {
        ext.prefix = { "${meta.id}_mo${meta.overlap}" }
        ext.args   = { "--genome-size ${params.genome_size} --min-overlap ${meta.overlap} --iterations ${params.flye_iterations}" }
        publishDir = [ path: { "${params.outdir}/flye/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    withName: 'SELECT_BEST_ASSEMBLY' {
        publishDir = [ path: { "${params.outdir}/best_assembly/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // Racon polishing rounds
    withName: '.*RACON.*' {
        publishDir = [ path: { "${params.outdir}/racon/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: '.*RACON3' {
        ext.prefix = { "${meta.id}_polished" }
    }

    withName: 'ASSEMBLY_METRICS' {
        publishDir = [ path: { "${params.outdir}/assembly_metrics/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    withName: 'READ_QC' {
        publishDir = [ path: { "${params.outdir}/read_qc/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    withName: 'MITOZ_ANNOTATE' {
        publishDir = [ path: { "${params.outdir}/mitoz/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    withName: 'BLASTN_REMOTE' {
        publishDir = [ path: { "${params.outdir}/blast/${meta.id}" }, mode: params.publish_dir_mode ]
    }
}
