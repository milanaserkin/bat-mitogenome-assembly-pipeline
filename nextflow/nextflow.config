// bat-mitogenome pipeline configuration

params {
    // Input / output
    input   = null
    outdir  = 'results'

    // Reference-guided read extraction
    min_alignment_length = 500          // keep reads with alignment length > this (bp)

    // Assembly
    genome_size          = 17000        // expected mitogenome size (bp)
    flye_iterations      = 3
    flye_min_overlaps    = [1000, 1100, 1200, 1300, 1400, 1500, 1600, 1700, 1800, 1900, 2000, 2500]

    // Tool arguments (mirror the original SLURM scripts)
    porechop_args  = '--check_reads 50000 --adapter_threshold 85 --end_size 200 --min_split_read_size 200'
    fastplong_args = '-l 600 -q 12 -s TGGTTCAGTT'
    minimap2_args  = '-x map-ont'

    // QC checks
    qc_short_read_length = 200
    qc_adapter1          = 'AAGCAGTGGTATCAACGCAGAGTAC'
    qc_adapter2          = 'TTTCTGTTGGTGCTGATATTGCTG'

    // Annotation (MitoZ)
    run_mitoz          = true
    mitoz_clade        = 'Chordata'
    mitoz_genetic_code = 2
    mitoz_mark_circular = true

    // Species identification (remote BLAST against NCBI)
    run_blast             = true
    blast_db              = 'nt'
    blast_max_target_seqs = 10
    blast_outfmt          = '6 qseqid sseqid pident length mismatch gapopen evalue bitscore stitle'

    publish_dir_mode = 'copy'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    conda {
        conda.enabled = true
    }
    wave {
        wave.enabled    = true
        wave.strategy   = 'conda,container'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

manifest {
    name            = 'bat-mitogenome'
    author          = 'ported from SLURM workflow'
    description      = 'Bat mitochondrial genome assembly and species identification from ONT reads'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
}
